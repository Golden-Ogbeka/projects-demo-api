{
  "name": "projects-demo-api",
  "version": "1.0.0",
  "description": "Local dummy backend API for portfolio frontend and mobile projects.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start": "node dist/index.js",
    "type:check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,json}\""
  },
  "keywords": [
    "portfolio",
    "dummy-api",
    "express",
    "sqlite",
    "typescript"
  ],
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "multer": "^2.1.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
